      "routeKeys": {
        "nxtPid": "nxtPid",
        "nxtPvalId": "nxtPvalId"
      },
      "namedRegex": "^/api/findings/(?<nxtPid>[^/]+?)/validations/(?<nxtPvalId>[^/]+?)/check(?:/)?$"
    },
    {
      "page": "/api/imports/[id]",
      "regex": "^/api/imports/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/imports/(?<nxtPid>[^/]+?)(?:/)?$"
