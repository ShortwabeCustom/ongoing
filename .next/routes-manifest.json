    },
    {
      "page": "/api/findings/[id]/resolutions/[resId]",
      "regex": "^/api/findings/([^/]+?)/resolutions/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid",
        "nxtPresId": "nxtPresId"
      },
      "namedRegex": "^/api/findings/(?<nxtPid>[^/]+?)/resolutions/(?<nxtPresId>[^/]+?)(?:/)?$"
