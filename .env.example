# ============================================================================
# Pruebas María 2.0 — Environment Configuration
# ============================================================================
# Copy this file to .env.local and fill in actual values
# NEVER commit .env with real secrets

# ============================================================================
# DATABASE
# ============================================================================

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/pruebas_maria_dev?schema=public"

# ============================================================================
# EVIDENCE STORAGE (almacén privado local) — ADR-001 / P1-B
# ============================================================================
#
# ⚠️  TODAVÍA NO SE USA. Introducida en P1-B.1 (infraestructura dormant).
#     Ningún código productivo la lee aún; la conmutación ocurre en P1-B.2.
#     Documentada aquí para que la provisión del directorio pueda prepararse
#     ANTES de esa conmutación.
#
# Directorio raíz donde se almacenan las evidencias subidas en runtime.
# La configuración es FAIL-CLOSED: si falta o es inválida, la subida y la
# entrega fallan. No hay fallback a public/ ni a un directorio temporal.
#
# El directorio DEBE cumplir todos estos invariantes (ADR-001 D1 y D15):
#   - ruta absoluta;
#   - existir, ser un directorio, y ser legible/escribible por el proceso;
#   - pertenecer al usuario que ejecuta la aplicación;
#   - tener permisos exactamente 0700 (los ficheros se crean con 0600);
#   - estar FUERA del repositorio y de process.cwd();
#   - estar FUERA del árbol de build (.next/) y de public/;
#   - estar FUERA de /tmp y /var/tmp;
#   - ser durable entre despliegues y estar INCLUIDO en el backup.
#
# La validación se memoiza por proceso, tanto el éxito como el error: corregir
# la ruta, los permisos o el owner exige reiniciar/recargar el proceso.
#
# Provisión típica:
#   sudo mkdir -p /var/lib/pruebas-maria/evidence
#   sudo chown <usuario-app>:<grupo-app> /var/lib/pruebas-maria/evidence
#   sudo chmod 0700 /var/lib/pruebas-maria/evidence
EVIDENCE_STORAGE_DIR="/var/lib/pruebas-maria/evidence"

# ============================================================================
# STORAGE (S3-Compatible: AWS S3, Cloudflare R2, MinIO)
#
# NOTA: los clientes R2/S3 están HUÉRFANOS (ADR-001 D11). No se activan en
# P1-B; su uso futuro reabriría también la evaluación de signed URLs (D4).
# ============================================================================

# Examples:
# - Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com, region "auto"
# - MinIO local: http://localhost:9000, region "us-east-1", force path style "true"
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="pruebas-maria-evidence"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# For signed URLs expiration (seconds) — default 24 hours
S3_SIGNED_URL_EXPIRY="86400"

# ============================================================================
# AUTHENTICATION
# ============================================================================

# Auth.js / NextAuth configuration
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# OAuth providers (if using)
GITHUB_ID=""
GITHUB_SECRET=""

# ============================================================================
# APPLICATION
# ============================================================================

# Next.js environment
NODE_ENV="development"

# API Base URL (for frontend AJAX calls)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Feature flags
NEXT_PUBLIC_ENABLE_OFFLINE_SYNC="false"
NEXT_PUBLIC_IMPORT_MAX_FILE_SIZE="52428800"

# Analytics
NEXT_PUBLIC_ANALYTICS_ID=""

# ============================================================================
# SEARCH (Elasticsearch)
# ============================================================================

# Elasticsearch connection URL
# Local development: http://localhost:9200
# Start local Elasticsearch: docker-compose up -d elasticsearch
ELASTICSEARCH_URL="http://localhost:9200"

# Elasticsearch index name for findings
ELASTICSEARCH_FINDINGS_INDEX="findings-v1"

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Error tracking (Sentry, etc)
SENTRY_DSN=""

# Log level: "debug" | "info" | "warn" | "error"
LOG_LEVEL="info"

# ============================================================================
# INTERNAL / DEVELOPMENT
# ============================================================================

# Database seeding (dev only)
SEED_DB="false"

# Rate limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"
