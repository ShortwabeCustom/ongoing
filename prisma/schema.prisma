// Pruebas María 2.0 — Evidence Management Platform
// Database Schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// AUTH & USERS
// ============================================================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String?   // Nullable for OAuth users (future)
  role         UserRole  @default(VIEWER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // Owner of projects
  ownedProjects  Project[]         @relation("ProjectOwner")

  projectMembers ProjectMember[]

  // Finding relationships
  findingsCreated       Finding[]         @relation("FindingCreatedBy")
  findingsUpdated       Finding[]         @relation("FindingUpdatedBy")
  findingsAssigned      Finding[]         @relation("FindingAssignee")

  // Sessions
  createdSessions       TestSession[]     @relation("SessionCreator")
  sessions              Session[]

  // Evidence and comments
  evidence              Evidence[]
  evidenceDeleted       Evidence[]        @relation("EvidenceDeletedBy")
  comments              Comment[]

  // Resolutions and validations
  resolutions           Resolution[]      @relation("ResolutionCreator")
  validations           Validation[]      @relation("ValidationValidator")

  // Audit
  statusHistory         FindingStatusHistory[] @relation("HistoryChanger")
  auditLogs             AuditLog[]        @relation("AuditActor")

  importBatches         ImportBatch[]     @relation("ImportImporter")

  // Push Notifications (FASE 9)
  pushSubscriptions      PushSubscription[] @relation("PushSubscriptions")
  notifications         Notification[]     @relation("Notifications")

  // Real-time Collaboration (FASE 10)
  activities            Activity[]         @relation("Activities")

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model Session {
  id     String    @id
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime

  @@index([userId])
  @@map("sessions")
}

enum UserRole {
  OWNER
  QA_LEAD
  DESIGNER
  DEVELOPER
  BUSINESS_REVIEWER
  VIEWER
}

// ============================================================================
// PROJECTS & ORGANIZATION
// ============================================================================

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  owner       User     @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  members      ProjectMember[]
  versions     ProductVersion[]
  testSessions TestSession[]
  findings     Finding[]
  importBatches ImportBatch[]

  @@index([ownerId])
  @@index([deletedAt])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      UserRole
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model ProductVersion {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version    String   // "1.0.0", "1.1.0", etc
  releasedAt DateTime?
  createdAt  DateTime @default(now())

  testSessions TestSession[]

  @@unique([projectId, version])
  @@index([projectId])
  @@map("product_versions")
}

// ============================================================================
// TESTING & SESSIONS
// ============================================================================

model TestSession {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionId   String
  version     ProductVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  name        String   // "Pruebas 30 de julio"
  date        DateTime
  environment String?  // "dev", "staging", "prod"

  createdBy   String
  creator     User     @relation("SessionCreator", fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())

  findings     Finding[]
  importBatches ImportBatch[]

  @@index([projectId])
  @@index([versionId])
  @@index([createdBy])
  @@map("test_sessions")
}

// ============================================================================
// FINDINGS (CORE ENTITY)
// ============================================================================

model Finding {
  id    String @id @default(cuid())

  // Relationships
  projectId     String
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testSessionId String
  testSession   TestSession @relation(fields: [testSessionId], references: [id], onDelete: Cascade)

  // Business Data
  folio       String?
  observation String  // Main finding description

  // Status & Priority
  status  FindingStatus @default(OPEN)
  version Int           @default(1)  // Optimistic locking

  priority FindingPriority @default(MEDIUM)
  severity FindingSeverity @default(MINOR)
  effort   FindingEffort   @default(M)

  // Context
  previousScreen String?
  currentScreen  String?
  flowStep       String?

  // Assignment
  assigneeId String?
  assignee   User?   @relation("FindingAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate    DateTime?

  // Import Tracking
  sourceSheet  String?
  sourceRow    Int?
  sourceFingerprint String? @unique
  importBatchId String?
  importBatch  ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  // Audit
  createdBy String
  creator   User   @relation("FindingCreatedBy", fields: [createdBy], references: [id])
  createdAt DateTime @default(now())
  updatedBy String?
  updater   User?  @relation("FindingUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // Relations
  incidenceTypes  FindingIncidenceType[]
  experienceTags  FindingExperienceTag[]
  evidence        Evidence[]
  resolutions     Resolution[]
  validations     Validation[]
  comments        Comment[]
  statusHistory   FindingStatusHistory[]

  @@index([projectId])
  @@index([testSessionId])
  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([createdAt])
  @@index([importBatchId])
  @@index([deletedAt])
  @@index([createdAt, status])
  @@map("findings")
}

enum FindingStatus {
  OPEN
  TRIAGED
  IN_PROGRESS
  READY_FOR_VALIDATION
  VALIDATED
  CLOSED
  BLOCKED
  REOPENED
}

enum FindingPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingSeverity {
  COSMETIC
  MINOR
  MAJOR
  BLOCKER
}

enum FindingEffort {
  S
  M
  L
  XL
}

// ============================================================================
// CATEGORIZATION (Many-to-Many)
// ============================================================================

model FindingIncidenceType {
  findingId String
  finding   Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  incidenceType IncidenceType

  @@id([findingId, incidenceType])
  @@index([findingId])
  @@map("finding_incidence_types")
}

enum IncidenceType {
  DESIGN
  FUNCTIONALITY
  BUSINESS_RULE
  COPY
}

model FindingExperienceTag {
  findingId String
  finding   Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  experienceTag ExperienceTag

  @@id([findingId, experienceTag])
  @@index([findingId])
  @@map("finding_experience_tags")
}

enum ExperienceTag {
  UI
  UX
  COPY
  DEV
}

// ============================================================================
// EVIDENCE
// ============================================================================

model Evidence {
  id        String   @id @default(cuid())
  findingId String
  finding   Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)

  type              EvidenceType
  storageKey        String       // S3 path
  url               String?      // Signed URL or external URL
  originalFilename  String
  mimeType          String
  fileSize          Int?         // bytes
  caption           String?

  // Workflow attachments (optional)
  resolutionId String?
  resolution   Resolution? @relation(fields: [resolutionId], references: [id], onDelete: SetNull)
  validationId String?
  validation   Validation? @relation(fields: [validationId], references: [id], onDelete: SetNull)

  createdBy String
  creator   User   @relation(fields: [createdBy], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedBy String?
  deleter   User?  @relation("EvidenceDeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)
  deletedAt DateTime?

  @@index([findingId])
  @@index([createdBy])
  @@index([deletedBy])
  @@index([deletedAt])
  @@index([resolutionId])
  @@index([validationId])
  @@map("evidence")
}

enum EvidenceType {
  IMAGE
  VIDEO
  DOCUMENT
  FIGMA_URL
  EXTERNAL_URL
}

// ============================================================================
// RESOLUTION & VALIDATION
// ============================================================================

model Resolution {
  id        String   @id @default(cuid())
  findingId String
  finding   Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)

  state       ResolutionState @default(OPEN)
  description String
  notes       String?
  assignedTo  String?

  // Evidence attached to this resolution
  evidence Evidence[]

  createdBy String
  creator   User   @relation("ResolutionCreator", fields: [createdBy], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([findingId])
  @@index([state])
  @@index([assignedTo])
  @@index([createdBy])
  @@map("resolutions")
}

enum ResolutionState {
  OPEN
  TRIAGED
  INVESTIGATING
  PROPOSED
  APPROVED
  IMPLEMENTED
  VERIFIED
  CLOSED
}

model Validation {
  id        String   @id @default(cuid())
  findingId String
  finding   Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)

  result ValidationResult @default(PENDING)
  criteria Json? // Array of { id, name, passed, notes }
  notes    String?

  // Evidence attached to this validation
  evidence Evidence[]

  validatedBy String?
  validator   User?   @relation("ValidationValidator", fields: [validatedBy], references: [id], onDelete: SetNull)
  validatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([findingId])
  @@index([result])
  @@index([validatedBy])
  @@index([result, validatedAt])
  @@map("validations")
}

enum ValidationResult {
  PENDING
  PASS
  FAIL
}

// ============================================================================
// COMMENTS
// ============================================================================

model Comment {
  id        String   @id @default(cuid())
  findingId String
  finding   Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)

  text String

  createdBy String
  creator   User   @relation(fields: [createdBy], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([findingId])
  @@index([createdBy])
  @@map("comments")
}

// ============================================================================
// AUDIT TRAIL
// ============================================================================

model FindingStatusHistory {
  id        String   @id @default(cuid())
  findingId String
  finding   Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)

  fromStatus FindingStatus
  toStatus   FindingStatus
  reason     String?

  changedBy String
  changer   User   @relation("HistoryChanger", fields: [changedBy], references: [id])
  changedAt DateTime @default(now())

  @@index([findingId])
  @@index([changedBy])
  @@index([toStatus, changedAt])
  @@map("finding_status_history")
}

model AuditLog {
  id        String   @id @default(cuid())

  entityType String
  entityId   String
  action     AuditAction

  actorId String?
  actor   User?  @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  before Json?
  after  Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  ASSIGN
  VALIDATE
  RESOLVE
  IMPORT
}

// ============================================================================
// IMPORT BATCH
// ============================================================================

model ImportBatch {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testSessionId String
  testSession   TestSession @relation(fields: [testSessionId], references: [id], onDelete: Cascade)

  originalFilename String
  fileSize         Int
  importedAt       DateTime @default(now())

  totalRows   Int
  validRows   Int
  skippedRows Int

  status       ImportStatus
  errorMessage String?

  importedBy String
  importer   User   @relation("ImportImporter", fields: [importedBy], references: [id])
  createdAt  DateTime @default(now())

  findings Finding[]

  @@index([projectId])
  @@index([importedBy])
  @@map("import_batches")
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  ROLLED_BACK
}

// ============================================================================
// PUSH NOTIFICATIONS (FASE 9)
// ============================================================================

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("PushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String   @unique
  auth      String   // Base64 auth key
  p256dh    String   // Base64 p256dh key
  userAgent String?

  createdAt DateTime @default(now())
  expiresAt DateTime?

  @@index([userId])
  @@index([createdAt])
  @@map("push_subscriptions")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("Notifications", fields: [userId], references: [id], onDelete: Cascade)

  title     String
  body      String
  type      String?
  data      Json?
  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ============================================================================
// REAL-TIME COLLABORATION (FASE 10)
// ============================================================================

model Activity {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation("Activities", fields: [userId], references: [id], onDelete: Cascade)

  action        ActivityAction
  resourceType  String          // "finding", "resolution", "comment", etc
  resourceId    String

  details       Json?           // Additional context about the action
  ipAddress     String?
  userAgent     String?

  createdAt     DateTime        @default(now())

  @@index([userId])
  @@index([resourceId])
  @@index([action])
  @@index([createdAt])
  @@map("activities")
}

enum ActivityAction {
  FINDING_CREATED
  FINDING_UPDATED
  FINDING_DELETED
  FINDING_VIEWED
  RESOLUTION_ADDED
  RESOLUTION_UPDATED
  VALIDATION_COMPLETED
  COMMENT_ADDED
  STATUS_CHANGED
  ASSIGNED
}

enum UserStatus {
  ONLINE
  EDITING
  IDLE
  OFFLINE
}
